<!-- Archivo de suite TestNG que define las clases a ejecutar -->
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">
<suite name="API Test Suite">
    <listeners>
        <!-- Listener de Allure para capturar los resultados de los tests -->
        <listener class-name="io.qameta.allure.testng.AllureTestNg"/>
    </listeners>
    <test name="API Tests">
        <classes>
            <class name="tests.ApiHealthTest"/>
            <class name="tests.PostApiTest"/>
            <class name="tests.DataDrivenPostTest"/>
            <class name="tests.HeaderManagerTest"/>
            <class name="tests.CookiesManagerTest"/>
        </classes>
    </test>
</suite>
